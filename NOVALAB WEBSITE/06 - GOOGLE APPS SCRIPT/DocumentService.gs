function para_(body,text,heading) { if(!text_(text))return null; const p=body.appendParagraph(text_(text)); if(heading)p.setHeading(heading); return p; }
function createArticleDocument_(data) { const doc=DocumentApp.create(data.articleId+' - '+text_(data.title)); DriveApp.getFileById(doc.getId()).moveTo(getOrCreateFolder_(NOVALAB_CONFIG.FOLDERS.ARTICLES)); const body=doc.getBody();body.clear(); para_(body,'NovaLab',DocumentApp.ParagraphHeading.TITLE);para_(body,'Science without boundaries.',DocumentApp.ParagraphHeading.SUBTITLE);para_(body,text_(data.title),DocumentApp.ParagraphHeading.HEADING1);para_(body,'Autor: '+text_(data.author)+' | Disciplina: '+text_(data.discipline),DocumentApp.ParagraphHeading.NORMAL);para_(body,'Rezumat',DocumentApp.ParagraphHeading.HEADING2);para_(body,text_(data.summary),DocumentApp.ParagraphHeading.NORMAL);para_(body,'Introducere',DocumentApp.ParagraphHeading.HEADING2);para_(body,text_(data.introduction),DocumentApp.ParagraphHeading.NORMAL); for(let i=1;i<=3;i++){const h=text_(data['section'+i+'Heading']),c=text_(data['section'+i+'Content']);if(h)para_(body,h,DocumentApp.ParagraphHeading.HEADING2);if(c)para_(body,c,DocumentApp.ParagraphHeading.NORMAL);} para_(body,'Concluzie',DocumentApp.ParagraphHeading.HEADING2);para_(body,text_(data.conclusion),DocumentApp.ParagraphHeading.NORMAL);para_(body,'Surse și referințe',DocumentApp.ParagraphHeading.HEADING2);para_(body,text_(data.references),DocumentApp.ParagraphHeading.NORMAL);doc.saveAndClose();return doc; }
function createEventDocument_(e) { const doc=DocumentApp.create(e.eventId+' - '+text_(e.title));DriveApp.getFileById(doc.getId()).moveTo(getOrCreateFolder_(NOVALAB_CONFIG.FOLDERS.EVENTS));const body=doc.getBody();body.clear();para_(body,'NovaLab',DocumentApp.ParagraphHeading.TITLE);para_(body,'Science without boundaries.',DocumentApp.ParagraphHeading.SUBTITLE);para_(body,text_(e.title),DocumentApp.ParagraphHeading.HEADING1);para_(body,text_(e.shortDescription),DocumentApp.ParagraphHeading.NORMAL);para_(body,'Detalii',DocumentApp.ParagraphHeading.HEADING2);para_(body,text_(e.fullDescription),DocumentApp.ParagraphHeading.NORMAL);para_(body,'Locație',DocumentApp.ParagraphHeading.HEADING2);para_(body,text_(e.venue)+(e.address?' — '+text_(e.address):''),DocumentApp.ParagraphHeading.NORMAL);para_(body,'Data și ora',DocumentApp.ParagraphHeading.HEADING2);para_(body,text_(e.startDatetime)+(e.endDatetime?' — '+text_(e.endDatetime):'')+' ('+text_(e.timezone)+')',DocumentApp.ParagraphHeading.NORMAL);doc.saveAndClose();return doc; }
function readDocumentPlainText_(id) { if(!id)return '';try{return DocumentApp.openById(id).getBody().getText();}catch(error){console.error('Document read failed: '+error.message);return '';} }
function readDocumentBlocks_(id) { if(!id)return {blocks:[]};try{const body=DocumentApp.openById(id).getBody(),blocks=[];for(let i=0;i<body.getNumChildren();i++){const c=body.getChild(i);if(c.getType()===DocumentApp.ElementType.PARAGRAPH){const p=c.asParagraph(),t=text_(p.getText());if(!t)continue;let type='paragraph';if(p.getHeading()===DocumentApp.ParagraphHeading.HEADING1)type='h1';else if(p.getHeading()===DocumentApp.ParagraphHeading.HEADING2)type='h2';else if(p.getHeading()===DocumentApp.ParagraphHeading.HEADING3)type='h3';blocks.push({type:type,text:t});}else if(c.getType()===DocumentApp.ElementType.LIST_ITEM){blocks.push({type:'list',text:text_(c.asListItem().getText())});}}return {blocks:blocks};}catch(error){console.error('Document parse failed: '+error.message);return {blocks:[]};} }
